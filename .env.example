# Copy to .env and adjust. Never commit .env.

# Host names the browser uses to reach Life Hub (comma-separated, no scheme).
# Loopback names are always allowed. Example: LAN IP and Tailscale Serve name.
ALLOWED_HOSTS=192.0.2.10,life-hub.example.ts.net
# Reverse proxies whose X-Forwarded-Proto/-Host headers are trusted (IPs or CIDRs).
# Tailscale Serve on the Docker host reaches the container from the Docker bridge.
TRUSTED_PROXIES=127.0.0.1,172.16.0.0/12
TZ=Europe/Zurich

# Listener ports (compose publishes the same port numbers on the host).
# PORT=3000
# MCP_PORT=3001
# Host addresses compose publishes the ports on, e.g. a Tailscale IP for MCP_BIND.
# LIFE_HUB_BIND=0.0.0.0
# MCP_BIND=0.0.0.0

# OpenAI-compatible agent endpoint, including the API prefix (usually /v1).
AGENT_BASE_URL=http://agent.example.ts.net:8642/v1
AGENT_API_KEY=change-me
AGENT_MODEL=hermes
# AGENT_TIMEOUT_MS=120000
# AGENT_MAX_HISTORY_MESSAGES=20
# AGENT_MAX_HISTORY_CHARS=24000

# Bearer token for /mcp on MCP_PORT, at least 32 characters. Generate with:
#   openssl rand -hex 32
# Without it the MCP endpoint answers 503.
MCP_AUTH_TOKEN=
# Browser origins allowed to call /mcp (agents normally send no Origin).
# MCP_ALLOWED_ORIGINS=
# Set to false to hide task notes from the agent.
# MCP_EXPOSE_TASK_NOTES=true

# Feeds
# FEED_REFRESH_INTERVAL_MS=1800000
# Allow feeds on private/LAN/Tailscale addresses (blocked by default, SSRF protection).
# ALLOW_PRIVATE_FEED_URLS=false
# FEED_RETENTION_DAYS=30

# Backups in /data/backups
# BACKUP_KEEP=7
